rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Study materials path: allow all authenticated users to read and download
    match /study_materials/{allPaths=**} {
      allow read: if request.auth != null;
      // Allow authenticated users to upload files less than 25MB
      allow write: if request.auth != null 
        && request.resource.size < 25 * 1024 * 1024;
    }
    
    // Default fallback rule
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
